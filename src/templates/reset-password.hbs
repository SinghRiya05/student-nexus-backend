<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <title>Reset Your Password</title>
</head>

<body style="margin:0; padding:0; background-color:#f6f9fc; font-family:Arial, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="padding:30px 0;">
        <tr>
            <td align="center">

                <!-- Container -->
                <table width="520" cellpadding="0" cellspacing="0"
                    style="background:#ffffff; border-radius:10px; overflow:hidden;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding:30px; background:#4CAF50; color:#ffffff;">
                            <h1 style="margin:0; font-size:22px;">Student Nexus</h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding:30px; color:#333;">

                            <h2 style="margin-top:0;">Reset Your Password</h2>

                            <p style="font-size:14px;">
                                Hi <strong>{{userName}}</strong>,
                            </p>

                            <p style="font-size:14px;">
                                We received a request to reset your password. Click the button below to set a new
                                password.
                            </p>

                            <!-- Button -->
                            <div style="text-align:center; margin:25px 0;">
                                <a href="{{resetUrl}}"
                                    style="background:#4CAF50; color:#ffffff; padding:12px 25px; border-radius:6px; text-decoration:none; font-weight:bold; display:inline-block;">
                                    Reset Password
                                </a>
                            </div>

                            <!-- Expiry -->
                            <p style="font-size:13px; color:#777;">
                                This link will expire in <strong>{{expiryMinutes}} minutes</strong>.
                            </p>

                            <!-- Security Note -->
                            <div style="background:#f1f1f1; padding:15px; border-radius:6px; margin-top:20px;">
                                <p style="font-size:13px; margin:0; color:#666;">
                                    If you did not request a password reset, you can safely ignore this email.
                                </p>
                            </div>

                            <!-- Fallback URL -->
                            <p style="font-size:13px; margin-top:20px;">
                                If the button doesn’t work, copy and paste this link into your browser:
                                <br />
                                <a href="{{resetUrl}}" style="color:#4CAF50; word-break:break-all;">
                                    {{resetUrl}}
                                </a>
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding:20px; font-size:12px; color:#999;">
                            © {{year}} Student Nexus. All rights reserved.
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>
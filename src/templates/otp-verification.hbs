<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <title>Email Verification</title>
</head>

<body style="margin:0; padding:0; background-color:#f6f9fc; font-family:Arial, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="padding:30px 0;">
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table width="520" cellpadding="0" cellspacing="0"
          style="background:#ffffff; border-radius:10px; padding:30px; box-shadow:0 4px 10px rgba(0,0,0,0.05);">

          <!-- Logo / App Name -->
          <tr>
            <td align="center" style="padding-bottom:20px;">
              <h1 style="margin:0; font-size:22px; color:#4CAF50;">
                {{appName}}
              </h1>
            </td>
          </tr>

          <!-- Title -->
          <tr>
            <td align="center" style="padding-bottom:20px;">
              <h2 style="margin:0; color:#333;">Verify Your Email</h2>
            </td>
          </tr>

          <!-- Greeting -->
          <tr>
            <td>
              <p style="font-size:15px; color:#555;">
                Hi <strong>{{firstName}}</strong>,
              </p>

              <p style="font-size:14px; color:#555;">
                Thanks for signing up! Please use the OTP below to complete your email verification.
              </p>
            </td>
          </tr>

          <!-- OTP Box -->
          <tr>
            <td align="center" style="padding:25px 0;">
              <div style="
                display:inline-block;
                padding:15px 30px;
                background:#f1f8f4;
                border:1px dashed #4CAF50;
                border-radius:8px;
                font-size:30px;
                font-weight:bold;
                color:#4CAF50;
                letter-spacing:6px;
              ">
                {{otp}}
              </div>
            </td>
          </tr>

          <!-- Expiry -->
          <tr>
            <td align="center">
              <p style="font-size:13px; color:#888;">
                This OTP will expire in <strong>{{expiryMinutes}} minutes</strong>.
              </p>
            </td>
          </tr>

          <!-- Warning -->
          <tr>
            <td>
              <p style="font-size:13px; color:#999; margin-top:20px;">
                If you didn’t request this, you can safely ignore this email.
              </p>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:20px 0;">
              <hr style="border:none; border-top:1px solid #eee;" />
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="font-size:12px; color:#aaa;">
              © {{year}} {{appName}}. All rights reserved.
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>

</html>